digraph ERD {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=11, nodesep=0.35, ranksep=0.9, splines=true, pad=0.3];
  node [fontname="DejaVu Sans", fontsize=10];
  edge [color="#666666", arrowsize=0.7, dir=both, arrowtail=tee, arrowhead=crow];
  subgraph cluster_platform { label="Platform"; style="rounded,filled"; fillcolor="#E8EAF6"; color="#BBBBBB"; fontsize=12;
  tenants [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555"><TR><TD BGCOLOR="#3F51B5" ALIGN="LEFT"><FONT COLOR="white"><B>tenants</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">id <FONT COLOR='#777777' POINT-SIZE='9'>PK</FONT></TD></TR></TABLE>>];
  users [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555"><TR><TD BGCOLOR="#3F51B5" ALIGN="LEFT"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">id <FONT COLOR='#777777' POINT-SIZE='9'>PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">role</TD></TR></TABLE>>];
  audit_logs [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555"><TR><TD BGCOLOR="#3F51B5" ALIGN="LEFT"><FONT COLOR="white"><B>audit_logs</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">id <FONT COLOR='#777777' POINT-SIZE='9'>PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">user_id <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_receivables { label="Receivables"; style="rounded,filled"; fillcolor="#E3F2FD"; color="#BBBBBB"; fontsize=12;
  customers [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555"><TR><TD BGCOLOR="#1976D2" ALIGN="LEFT"><FONT COLOR="white"><B>customers</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">id <FONT COLOR='#777777' POINT-SIZE='9'>PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">tier</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">assigned_collector <FONT COLOR='#777777' POINT-SIZE='9'>FK?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">preferred_channel</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">status</TD></TR></TABLE>>];
  invoices [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555"><TR><TD BGCOLOR="#1976D2" ALIGN="LEFT"><FONT COLOR="white"><B>invoices</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">id <FONT COLOR='#777777' POINT-SIZE='9'>PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">customer_id <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">status</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">disputed_by <FONT COLOR='#777777' POINT-SIZE='9'>FK?</FONT></TD></TR></TABLE>>];
  payments [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555"><TR><TD BGCOLOR="#1976D2" ALIGN="LEFT"><FONT COLOR="white"><B>payments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">id <FONT COLOR='#777777' POINT-SIZE='9'>PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">customer_id <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">invoice_id <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR></TABLE>>];
  promises_to_pay [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555"><TR><TD BGCOLOR="#1976D2" ALIGN="LEFT"><FONT COLOR="white"><B>promises_to_pay</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">id <FONT COLOR='#777777' POINT-SIZE='9'>PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">customer_id <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">invoice_id <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">status</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">recorded_by <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR></TABLE>>];
  risk_scores [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555"><TR><TD BGCOLOR="#1976D2" ALIGN="LEFT"><FONT COLOR="white"><B>risk_scores</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">id <FONT COLOR='#777777' POINT-SIZE='9'>PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">customer_id <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">level</TD></TR></TABLE>>];
  }
  subgraph cluster_memory { label="Memory"; style="rounded,filled"; fillcolor="#E8F5E9"; color="#BBBBBB"; fontsize=12;
  customer_notes [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555"><TR><TD BGCOLOR="#388E3C" ALIGN="LEFT"><FONT COLOR="white"><B>customer_notes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">id <FONT COLOR='#777777' POINT-SIZE='9'>PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">customer_id <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">note_type</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">embedding <FONT COLOR='#777777' POINT-SIZE='9'>vector</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">author_id <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">source</TD></TR></TABLE>>];
  conversations [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555"><TR><TD BGCOLOR="#388E3C" ALIGN="LEFT"><FONT COLOR="white"><B>conversations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">id <FONT COLOR='#777777' POINT-SIZE='9'>PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">user_id <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">customer_id <FONT COLOR='#777777' POINT-SIZE='9'>FK?</FONT></TD></TR></TABLE>>];
  messages [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555"><TR><TD BGCOLOR="#388E3C" ALIGN="LEFT"><FONT COLOR="white"><B>messages</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">id <FONT COLOR='#777777' POINT-SIZE='9'>PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">conversation_id <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">role</TD></TR></TABLE>>];
  }
  subgraph cluster_agent { label="Agent and decisions"; style="rounded,filled"; fillcolor="#FFF3E0"; color="#BBBBBB"; fontsize=12;
  agent_runs [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555"><TR><TD BGCOLOR="#F57C00" ALIGN="LEFT"><FONT COLOR="white"><B>agent_runs</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">id <FONT COLOR='#777777' POINT-SIZE='9'>PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">user_id <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR></TABLE>>];
  recommendations [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555"><TR><TD BGCOLOR="#F57C00" ALIGN="LEFT"><FONT COLOR="white"><B>recommendations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">id <FONT COLOR='#777777' POINT-SIZE='9'>PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">customer_id <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">agent_run_id <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">action</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">status</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">decided_by <FONT COLOR='#777777' POINT-SIZE='9'>FK?</FONT></TD></TR></TABLE>>];
  draft_versions [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555"><TR><TD BGCOLOR="#F57C00" ALIGN="LEFT"><FONT COLOR="white"><B>draft_versions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">id <FONT COLOR='#777777' POINT-SIZE='9'>PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">recommendation_id <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">tone</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">created_by <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR></TABLE>>];
  collection_tasks [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555"><TR><TD BGCOLOR="#F57C00" ALIGN="LEFT"><FONT COLOR="white"><B>collection_tasks</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">id <FONT COLOR='#777777' POINT-SIZE='9'>PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">customer_id <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">recommendation_id <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">assigned_to <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">priority</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">action</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">status</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">created_by <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_policy { label="Policy and RAG"; style="rounded,filled"; fillcolor="#F3E5F5"; color="#BBBBBB"; fontsize=12;
  documents [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555"><TR><TD BGCOLOR="#7B1FA2" ALIGN="LEFT"><FONT COLOR="white"><B>documents</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">id <FONT COLOR='#777777' POINT-SIZE='9'>PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">type</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">uploaded_by <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR></TABLE>>];
  document_chunks [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555"><TR><TD BGCOLOR="#7B1FA2" ALIGN="LEFT"><FONT COLOR="white"><B>document_chunks</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">id <FONT COLOR='#777777' POINT-SIZE='9'>PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">document_id <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">customer_id <FONT COLOR='#777777' POINT-SIZE='9'>FK?</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">embedding <FONT COLOR='#777777' POINT-SIZE='9'>vector</FONT></TD></TR></TABLE>>];
  policy_rules [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555"><TR><TD BGCOLOR="#7B1FA2" ALIGN="LEFT"><FONT COLOR="white"><B>policy_rules</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">id <FONT COLOR='#777777' POINT-SIZE='9'>PK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">rule_type</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">source_document_id <FONT COLOR='#777777' POINT-SIZE='9'>FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">confirmed_by <FONT COLOR='#777777' POINT-SIZE='9'>FK?</FONT></TD></TR></TABLE>>];
  tenant_settings [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#555555"><TR><TD BGCOLOR="#7B1FA2" ALIGN="LEFT"><FONT COLOR="white"><B>tenant_settings</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">tenant_id <FONT COLOR='#777777' POINT-SIZE='9'>PK FK</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">updated_by <FONT COLOR='#777777' POINT-SIZE='9'>FK?</FONT></TD></TR></TABLE>>];
  }
  users -> customers [label="assigned_collector", fontsize=8, fontcolor="#555555", style=dashed];
  customers -> invoices [label="customer_id", fontsize=8, fontcolor="#555555"];
  customers -> payments [label="customer_id", fontsize=8, fontcolor="#555555"];
  invoices -> payments [label="invoice_id", fontsize=8, fontcolor="#555555"];
  customers -> promises_to_pay [label="customer_id", fontsize=8, fontcolor="#555555"];
  invoices -> promises_to_pay [label="invoice_id", fontsize=8, fontcolor="#555555"];
  customers -> customer_notes [label="customer_id", fontsize=8, fontcolor="#555555"];
  customers -> recommendations [label="customer_id", fontsize=8, fontcolor="#555555"];
  agent_runs -> recommendations [label="agent_run_id", fontsize=8, fontcolor="#555555"];
  recommendations -> draft_versions [label="recommendation_id", fontsize=8, fontcolor="#555555"];
  customers -> collection_tasks [label="customer_id", fontsize=8, fontcolor="#555555"];
  recommendations -> collection_tasks [label="recommendation_id", fontsize=8, fontcolor="#555555"];
  users -> collection_tasks [label="assigned_to", fontsize=8, fontcolor="#555555"];
  users -> conversations [label="user_id", fontsize=8, fontcolor="#555555"];
  customers -> conversations [label="customer_id", fontsize=8, fontcolor="#555555", style=dashed];
  conversations -> messages [label="conversation_id", fontsize=8, fontcolor="#555555"];
  documents -> document_chunks [label="document_id", fontsize=8, fontcolor="#555555"];
  customers -> document_chunks [label="customer_id", fontsize=8, fontcolor="#555555", style=dashed];
  documents -> policy_rules [label="source_document_id", fontsize=8, fontcolor="#555555"];
  customers -> risk_scores [label="customer_id", fontsize=8, fontcolor="#555555"];
  users -> agent_runs [label="user_id", fontsize=8, fontcolor="#555555"];
}